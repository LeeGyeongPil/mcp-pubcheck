{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/LeeGyeongPil/mcp-pubcheck/schemas/report.schema.json",
  "title": "mcp-pubcheck report",
  "description": "Output of `mcp-pubcheck --json`. Rule IDs and keys are language independent; message and fix follow --lang.",
  "type": "object",
  "required": ["tool", "version", "language", "serverJson", "summary", "findings"],
  "properties": {
    "tool": { "const": "mcp-pubcheck" },
    "version": { "type": "string" },
    "language": { "enum": ["en", "ko"] },
    "demo": { "type": "boolean", "description": "True for the bundled practice example (`mcp-pubcheck demo`)." },
    "serverJson": { "type": "string" },
    "summary": {
      "type": "object",
      "required": ["errors", "warnings", "infos", "passed"],
      "properties": {
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "infos": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "level", "key", "where", "message"],
        "properties": {
          "rule": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "level": { "enum": ["error", "warn", "info", "ok"] },
          "key": { "type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$" },
          "where": { "type": "string" },
          "expected": { "type": "string" },
          "actual": { "type": "string" },
          "source": { "type": "string" },
          "message": { "type": "string" },
          "fix": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
